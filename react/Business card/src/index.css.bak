body {
  background-color: #23252C;
  color: white;
}

.main {
  width: 634px;
  height: 738px;
  margin-top: 10px;
  margin-left: 266px;
  background-color: #374151;
  display: flex;
  /* flex-direction: row; */
  /* flex-wrap: nowrap; */
  /* align-content: space-around; */
  justify-content: space-evenly;
  /* align-items: flex-start; */
}

.img img {
   display:flex;
   justify-self: center;
   align-items: center;
  width: 317px;
  height: 317px;
 
  

  opacity: 1;
  border-top-left-radius: 10px;
  border-top-right-radius: 10px;

}
.info{
  display:  flex;
  flex-direction: column;
  align-items: center;
}
.info h2{
color: #F3BF99;

}
.btn{
  background: #FFFFFF;
  width: 50%;
  border: 1px;
  border-radius: 6px;
  padding-top: 9px;
  padding-bottom: 9px;
  padding-right: 13px;
  padding-left: 11px;
}
.icon{
  display: inline;
}
.content{
 padding-top: 9px;
  padding-bottom: 9px;
  padding-right: 13px;
  padding-left: 11px;
}
